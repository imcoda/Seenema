<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="1080px" android:layout_height="wrap_content"
    android:background="#F5F2ED" android:orientation="vertical" android:padding="48px">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/media_app_branding" android:layout_width="0px"
            android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/app_name"
            android:fontFamily="@font/montserrat_semibold" android:textColor="#5D4774" android:textSize="28px" />
        <TextView android:id="@+id/media_metadata" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:fontFamily="@font/montserrat_medium"
            android:textColor="#59515F" android:textSize="30px" />
    </LinearLayout>
    <ImageView android:id="@+id/media_hero_image" android:layout_width="match_parent"
        android:layout_height="1476px" android:layout_marginTop="32px"
        android:scaleType="fitCenter" android:contentDescription="@null" />
    <TextView android:id="@+id/media_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="32px"
        android:fontFamily="@font/montserrat_semibold" android:textColor="#19151F"
        android:textSize="60px" android:includeFontPadding="false" android:lineSpacingExtra="8px" />
    <TextView android:id="@+id/media_director_label" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="18px"
        android:fontFamily="@font/montserrat_medium" android:textColor="#59515F" android:textSize="30px" />
</LinearLayout>
