<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="1080px" android:layout_height="wrap_content" android:gravity="center_vertical"
    android:background="#17121F" android:orientation="horizontal" android:padding="48px">
    <ImageView android:id="@+id/media_hero_image" android:layout_width="360px"
        android:layout_height="540px" android:scaleType="fitCenter" android:contentDescription="@null" />
    <LinearLayout android:layout_width="0px" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="44px" android:orientation="vertical">
        <View android:layout_width="48px" android:layout_height="6px" android:background="#9C71F6"
            android:layout_marginBottom="20px" />
        <TextView android:id="@+id/media_app_branding" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/app_name"
            android:fontFamily="@font/montserrat_medium" android:textColor="#C8B2EB" android:textSize="26px" />
        <TextView android:id="@+id/media_title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="24px"
            android:fontFamily="@font/montserrat_semibold" android:textColor="#FFFFFF"
            android:textSize="56px" android:includeFontPadding="false" android:lineSpacingExtra="8px" />
        <TextView android:id="@+id/media_metadata" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="24px"
            android:fontFamily="@font/montserrat_medium" android:textColor="#C9C0D2" android:textSize="30px" />
        <TextView android:id="@+id/media_director_label" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="24px"
            android:fontFamily="@font/montserrat_medium" android:textColor="#C9C0D2" android:textSize="28px" />
    </LinearLayout>
</LinearLayout>
