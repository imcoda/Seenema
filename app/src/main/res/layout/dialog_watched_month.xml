<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/watched_month_sheet_background"
    android:paddingHorizontal="20dp" android:paddingTop="12dp" android:paddingBottom="24dp">
    <View android:layout_width="36dp" android:layout_height="4dp"
        android:layout_gravity="center_horizontal" android:layout_marginBottom="24dp"
        android:background="@drawable/gallery_badge_background" android:backgroundTint="#655A73" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_semibold" android:text="@string/watched_month"
        android:textColor="@color/white" android:textSize="20sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="20dp" android:layout_marginBottom="24dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/watched_year" android:textColor="@color/text_secondary" android:textSize="13sp" />
            <NumberPicker android:id="@+id/watched_year_picker" android:theme="@style/SeenemaWheelOverlay"
                android:layout_width="match_parent" android:layout_height="184dp"
                android:contentDescription="@string/watched_year" android:descendantFocusability="blocksDescendants" />
        </LinearLayout>
        <Space android:layout_width="24dp" android:layout_height="1dp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/watched_month_label" android:textColor="@color/text_secondary" android:textSize="13sp" />
            <NumberPicker android:id="@+id/watched_month_picker" android:theme="@style/SeenemaWheelOverlay"
                android:layout_width="match_parent" android:layout_height="184dp"
                android:contentDescription="@string/watched_month_label" android:descendantFocusability="blocksDescendants" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end|center_vertical">
        <com.google.android.material.button.MaterialButton android:id="@+id/watched_month_cancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="48dp"
            android:text="@string/cancel" android:textAllCaps="false"
            android:fontFamily="@font/montserrat_medium" android:textColor="@color/text_secondary" />
        <com.google.android.material.button.MaterialButton android:id="@+id/watched_month_save"
            android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="12dp"
            android:paddingHorizontal="24dp" android:backgroundTint="@color/app_color"
            android:text="@string/save_changes" android:textAllCaps="false"
            android:fontFamily="@font/montserrat_semibold" android:textColor="@color/white" app:cornerRadius="14dp" />
    </LinearLayout>
</LinearLayout>
